is_winter(date(Y,M,D)) :-
    date(Y,M,D),
    M = 12.

is_winter(date(Y,M,D)) :-
    date(Y,M,D),
    M = 1.

is_winter(date(Y,M,D)) :-
    date(Y,M,D),
    M = 2.

is_summer(date(Y,M,D)) :-
    date(Y,M,D),
    M >= 6,
    M <= 8.

is_spring(date(Y,M,D)) :-
    date(Y,M,D),
    M >= 3,
    M <= 5.

is_autumn(date(Y,M,D)) :-
    date(Y,M,D),
    M >= 9,
    M <= 11.
