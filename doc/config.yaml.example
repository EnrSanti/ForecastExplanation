# Options shared by every run, each run can override them
defaults:
  workers: 12
  fold_rm:
    seed: 42

run_baseline:
  region: FVG
  dates:
    - 2009-01-02

run_custom_path_and_region:
  region:
    bounds: [-3, 3, 42.7, 45.8]
    radius: 5
    cities:
      CustomCity:
        lat: 44.25
        lon: 0.0
  dates:
    - 2009-01-04
    - start: 2009-01-10
      end: 2009-01-20
      step: 2
  output_path: runs/custom
  force: data             # recompute everything
  stop_after: learning
  clean: [cut]
  clustering: true
  debug: true
  save_images: true
  fold_rm:
    strategy: one_vs_rest
    ratio: 0.7
    split: date
    test_ratio: 0.3
    gpu: false
